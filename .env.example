# ---------- database ----------
DATABASE_URL=file:./data/pos.db

# ---------- auth (Better Auth) ----------
# URL publik aplikasi — wajib; gunakan https:// di produksi
BETTER_AUTH_URL=http://localhost:3000
# Wajib di produksi. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-secret-acak-64-karakter
# "true" untuk memaksa cookie secure (default: otomatis bila URL https://)
# AUTH_SECURE_COOKIES=true

# ---------- admin pertama (hanya dipakai saat database kosong) ----------
FIRST_ADMIN_NAME=Administrator
FIRST_ADMIN_EMAIL=admin@perusahaan.com
FIRST_ADMIN_PASSWORD=ganti-dengan-password-kuat
